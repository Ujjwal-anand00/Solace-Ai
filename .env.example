# Solace AI - Root Environment Reference
# Copy the specific .env.example files to apps/mobile/.env and apps/server/.env

# SERVER CONFIGURATION
SERVER_PORT=5000
SERVER_NODE_ENV=development
SERVER_MONGODB_URI=mongodb://127.0.0.1:27017/solace_ai
SERVER_JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long
SERVER_GEMINI_KEY=your_gemini_api_key_here
SERVER_GEMINI_MODEL=gemini-3.5-flash-lite
SERVER_CLIENT_URL=http://localhost:8081

# MOBILE CONFIGURATION
# Replace YOUR_LOCAL_IP with your machine's LAN IP (e.g., 192.168.1.4) for physical Android devices
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000

