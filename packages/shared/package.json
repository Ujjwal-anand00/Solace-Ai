{
  "name": "@solace/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types and constants for Solace AI",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
