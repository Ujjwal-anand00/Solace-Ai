# Node environment: development | production | test
NODE_ENV=development

# Server port
PORT=5000

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/solace_ai

# JWT Authentication Secret (min 32 characters)
JWT_SECRET=solace_ai_super_secret_jwt_key_development_32chars

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Allowed Client Origins for CORS (comma separated or wildcard)
CLIENT_URL=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081

